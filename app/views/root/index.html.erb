<% flash.each do |type, msg| %>
  <div class="border-b px-4 py-3 <%= alert_classes(type) %>" role="alert"><%= msg %></div>
<% end %>

<main class="flex-1">
  <div class="mx-auto max-w-5xl px-4 py-8">
    <div class="mx-auto max-w-2xl rounded-lg border border-gray-200 bg-white p-8 shadow-sm">
      <h1 class="mb-4 text-4xl font-bold">Пинг-понг</h1>
      <p class="mb-6 text-lg text-gray-600">
        Эта форма проверит сайт на доступность. Конечно, если не ничего не произойдет 🤔
      </p>

      <%= form_with url: domains_path, scope: :domain, data: { turbo: false } do |form| %>
        <div class="mb-2">
          <%= form.label :name, "Адрес", class: "mb-1 block text-sm font-medium" %>
          <%= form.text_field :name, placeholder: "https://google.ru/", class: "w-full rounded border border-gray-300 px-3 py-2" %>
          <p class="mt-1 text-sm text-gray-500">Введите адрес сайта, например https://google.ru/</p>
        </div>

        <%= form.submit "Отправить", class: "mt-4 cursor-pointer rounded bg-blue-600 px-6 py-3 text-white uppercase hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>
</main>

<footer class="border-t border-gray-200 bg-white py-4">
  <div class="mx-auto max-w-5xl px-4 text-center">
    <a class="text-blue-600 hover:underline" href="https://hexlet.io" target="_blank">Hexlet</a>
  </div>
</footer>
